# ====== MaxKB 后端环境变量示例 ======
# 复制本文件为 .env，填入真实值。.env 文件已被 .gitignore 排除，不会提交到 Git。

# ====== 服务 ======
NODE_ENV=development
PORT=3001

# ====== PostgreSQL ======
# 用户提供的远程 PG
PGHOST=119.91.234.159
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres
PGPASSWORD=__CHANGE_ME__
# 是否启用 SSL（生产环境建议 true）
PGSSL=false

# ====== JWT ======
# 用 openssl rand -hex 32 生成
JWT_SECRET=__GENERATE_RANDOM_64_HEX_CHARS__
JWT_EXPIRES_IN=7d

# ====== CORS 白名单（前端域名，逗号分隔） ======
# 生产：前端域名 + 本地调试
#
# ⚠️ https://v.taotaoedu.ltd（Vercel 备用线）必须留着：
#    前端 assets/js/api.js 的 resolveApiBase 会先探同源 /api/health，
#    探不通就退回绝对地址 https://taotaoedu.ltd 跨域直连源站。
#    备用线的边缘节点（国内客户端通常被路由到 sin1）偶尔连不上国内源站，
#    这时整条 /api/* 会 502 —— 跨域兜底就是那条救命路。
#    白名单里没有它，跨域请求会被 CORS 中间件拒掉（500），兜底形同虚设。
#    详见 VERCEL-DEPLOY.md 坑八。
CORS_ORIGINS=https://taotaoedu.ltd,https://www.taotaoedu.ltd,https://v.taotaoedu.ltd,https://taoj2025.github.io,http://localhost:8080

# ====== 公网 API 地址（Nginx 反代后的对外 URL） ======
# 前端 config.js 的 API_BASE 必须与此一致
API_PUBLIC_URL=https://taotaoedu.ltd/api

# ====== 管理员初始化（仅 scripts/init-admin.js 首次使用） ======
ADMIN_EMAIL=2949465671@qq.com
ADMIN_DEFAULT_PASSWORD=__CHANGE_ME_AFTER_FIRST_LOGIN__

# ====== 站点资源目录（绝对路径，默认指向 ../downloads） ======
DOWNLOADS_DIR=
