{
  "version": 2,
  "buildCommand": "bash scripts/build-vercel-site.sh",
  "outputDirectory": "site",
  "framework": null,

  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },

  "rewrites": [
    { "source": "/articles.json",       "destination": "https://taotaoedu.ltd/articles.json" },
    { "source": "/articles/:path*",     "destination": "https://taotaoedu.ltd/articles/:path*" },
    { "source": "/data/:path*",         "destination": "https://taotaoedu.ltd/data/:path*" },
    { "source": "/downloads/:path*",    "destination": "https://taotaoedu.ltd/downloads/:path*" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/assets/js/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],

  "env": {
    "ORIGIN_URL": "https://taotaoedu.ltd"
  }
}
